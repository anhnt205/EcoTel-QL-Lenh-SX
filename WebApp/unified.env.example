# Mẫu biến cho docker-compose.unified.yaml — sao chép thành WebApp/.env rồi điền giá trị THẬT trên máy chủ.
# KHÔNG commit file .env. Mật khẩu/khoá sinh ngẫu nhiên (vd: openssl rand -base64 36), không dùng giá trị mẫu.

# --- Bắt buộc ---
MONGO_PASSWORD=
TK_POSTGRES_PASSWORD=
# Khoá ký token đăng nhập một lần (Điều phối ký, Thống kê xác thực) — >= 32 ký tự, hai bên dùng chung.
TK_AUTH_JWT_SECRET=

# --- Tuỳ chọn ---
# Cổng host cho proxy (mặc định 6868)
UNIFIED_PORT=6868
# URL công khai của hệ thống (vd http://host:6868) — dùng cho Socket.IO của frontend Điều phối
PUBLIC_URL=
# Khoá Google Maps cho frontend Điều phối (bake lúc build)
VITE_MAP_API_KEY=
# Proxy HTTP :8888 (mặc định) hoặc HTTPS + tên miền
NGINX_CONF=nginx_thongke.conf
# "true" = hiện menu/khung Thống kê trong giao diện Điều phối (bake lúc build frontend). Mặc định của compose gộp là true.
VITE_TK_EMBED=true
# Tài khoản Thống kê CHỈ-ĐỌC cho đồng bộ danh mục (POST /api/catalog-sync/tk); bỏ trống nếu chưa dùng
TK_SERVICE_USERNAME=
TK_SERVICE_PASSWORD=
# Đặt `thongke` SAU khi đã chạy thử đồng bộ và kiểm kết quả: danh mục Điều phối thành chỉ-đọc
CATALOG_MASTER=

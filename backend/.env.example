# Copy thành .env (đã gitignore) để dùng với backend/docker-compose.yaml
# (chỉ Postgres + pgAdmin + backend — dùng khi chạy frontend riêng qua
# `pnpm dev`). Muốn preview đầy đủ (frontend + reverse-proxy + Postgres +
# Redis + backend) dùng deployment/preview/preview-docker-compose.yaml thay
# thế — không cần .env này, mọi giá trị đã đặt sẵn trong chính compose file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=thong_ke
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=CHANGE_ME_local_only
